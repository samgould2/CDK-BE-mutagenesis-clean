__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
env/

# rendered output is regenerated by the notebooks; keep the repo to code + data
figures/**/*.png
figures/**/*.pdf
figures/**/*.svg
!figures/**/.gitkeep

# never commit the excluded tiers by accident (see data/external/NOT_INCLUDED.csv)
data/external/*
!data/external/NOT_INCLUDED.csv

# ChimeraX command files are generated, and carry an absolute `cd` to wherever
# the repository is checked out (ChimeraX silently aborts on a relative path).
# Regenerate with scripts/chimerax/generate_*.py -- see scripts/chimerax/README.md.
scripts/chimerax/cxc/
scripts/chimerax/cxc_*/
